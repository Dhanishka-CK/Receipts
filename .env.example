# ==============================================================================
# RECEIPTS: Autonomous Voice Memory & Conflict Detection
# Environment Variables Configuration Template
# ==============================================================================

# --- Lyzr Multi-Agent Reasoning (Mandatory) ---
# Create 3 agents in Lyzr Studio (studio.lyzr.ai) using instructions in prompts/
# Leave empty for local development / testing to use built-in deterministic mock agents
LYZR_API_KEY=
LYZR_EXTRACTOR_AGENT_ID=
LYZR_AUDITOR_AGENT_ID=
LYZR_MANAGER_AGENT_ID=
# Mode: auto = mock when keys are absent; 1 = force mock; 0 = force production Lyzr API
MOCK_AGENTS=auto

# --- Qdrant Vector Database (Mandatory) ---
# For Qdrant Cloud (Production): provide cluster URL and API key
# For Local Embedded Storage: leave QDRANT_URL empty
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=receipts_memory
# fastembed = 384-d semantic vectors (BAAI/bge-small-en-v1.5); hash = fast offline unit tests
EMBED_BACKEND=fastembed

# --- Omi Wearable Integration (Mandatory) ---
# Webhook endpoints to configure in the Omi Mobile App Developer Mode:
# Realtime Transcript:  https://YOUR_DOMAIN/omi/realtime
# Conversation Memory:  https://YOUR_DOMAIN/omi/conversation
# Optional: To push proactive notification receipts back to the Omi phone app:
OMI_APP_ID=
OMI_APP_SECRET=

# --- System Policies & Guards ---
TZ=Asia/Kolkata
MIN_CONFIDENCE=0.7
MAX_ALERTS_PER_HOUR=10
FORGET_MIN_SCORE=0.45
REALTIME_IDLE_SECONDS=4
